# =========================================================================
# MPLADS Intelligence Engine & Analytical Core Backend Dockerfile
# =========================================================================
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app:/app/detectors" \
    MPLADS_BASE_DIR="/app" \
    PORT=8000

WORKDIR /app

# Install minimal OS dependencies for numerical libraries and healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi>=0.110.0 \
    "uvicorn[standard]>=0.28.0" \
    pandas>=2.1.0 \
    numpy>=1.26.0 \
    scipy>=1.11.0 \
    scikit-learn>=1.3.0 \
    pyarrow>=14.0.0 \
    joblib>=1.3.0 \
    pyjwt>=2.8.0 \
    python-multipart>=0.0.9 \
    httpx>=0.27.0 \
    pydantic>=2.6.0

# Copy application layers
COPY pyproject.toml /app/
COPY detectors /app/detectors
COPY data /app/data
COPY models /app/models
COPY backend /app/backend

# Create runtime directory for SQLite audit store
RUN mkdir -p /app/backend/data

EXPOSE 8000

# Container healthcheck against FastAPI health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Launch production ASGI server
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
