# =========================================================================
# Stage 1: Build React 18 TypeScript SPA
# =========================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Enable pnpm via Corepack matching lockfile v9
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy dependency manifests
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy frontend source files
COPY frontend/ ./

# Compile TypeScript and bundle production assets with Vite
RUN pnpm run build

# =========================================================================
# Stage 2: Serve SPA and Reverse Proxy API via Caddy
# =========================================================================
FROM caddy:latest

# Copy Caddy configuration
COPY docker/Caddyfile /etc/caddy/Caddyfile

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /srv

EXPOSE 5173

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:5173/ || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
